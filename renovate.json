{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "dependencyDashboard": true,
    "enabledManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions",
        "html",
        "pep621",
        "npm",
        "pip_requirements",
        "pre-commit"
    ],
    "gitAuthor": "RKIMetadataExchange <mex@rki.de>",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "on monday"
        ]
    },
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "description": "Apply all updates after cooldown of 7 days, hopefully avoiding malicious updates which are yanked in the meantime",
            "matchUpdateTypes": [
                "digest",
                "major",
                "minor",
                "patch",
                "pin"
            ],
            "minimumReleaseAge": "7 days",
            "minimumReleaseAgeBehaviour": "timestamp-optional"
        },
        {
            "description": "Renovate cannot enforce a cooldown on lock file maintenance, because uv resolves the lock file itself (renovatebot/renovate#41654); set explicitly so the rule above does not override renovate's own default and leave the stability check pending forever",
            "matchUpdateTypes": [
                "lockFileMaintenance"
            ],
            "minimumReleaseAge": null
        },
        {
            "description": "Pin GitHub Actions, compose images and base images to SHA digests for supply chain security",
            "matchManagers": [
                "docker-compose",
                "dockerfile",
                "github-actions"
            ],
            "pinDigests": true
        },
        {
            "description": "Group all GitHub Actions updates into a single PR",
            "groupName": "github-actions",
            "matchManagers": [
                "github-actions"
            ]
        },
        {
            "description": "Group all non-major Python updates into a single PR",
            "groupName": "python non-major",
            "matchCurrentVersion": "!/^0/",
            "matchManagers": [
                "pep621",
                "pip_requirements"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        },
        {
            "description": "Group all non-major npm updates into a single PR",
            "groupName": "npm non-major",
            "matchCurrentVersion": "!/^0/",
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin"
            ]
        },
        {
            "description": "Group Angular + TypeScript non-major updates into a single PR (needs to configure after the npm non-major rule)",
            "groupName": "all non-major Angular packages",
            "matchDepTypes": [
                "dependencies",
                "devDependencies"
            ],
            "matchPackageNames": [
                "/^@angular/",
                "@schematics/angular",
                "@angular-eslint/*",
                "angular-eslint",
                "typescript"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ]
        },
        {
            "description": "Group the vitest monorepo into a single PR (needs to be configured after the npm non-major rule), because @vitest/* peer-pin vitest to an exact version, so bumping vitest on its own leaves the lock file unresolvable",
            "groupName": "vitest",
            "matchSourceUrls": [
                "https://github.com/vitest-dev/vitest"
            ]
        },
        {
            "description": "TypeScript-Major only manually with Angular-Major",
            "enabled": false,
            "matchPackageNames": [
                "typescript"
            ],
            "matchUpdateTypes": [
                "major"
            ]
        },
        {
            "description": "npm-CLI-Version managed by nodeenv",
            "enabled": false,
            "matchPackageNames": [
                "npm"
            ]
        },
        {
            "description": "Group meta-requirements and pre-commit hooks into a single PR, keeping tools in sync with their hooks",
            "groupName": "tooling",
            "matchManagers": [
                "pip_requirements",
                "pre-commit"
            ]
        },
        {
            "description": "Keep both python base image stages moving together in one PR",
            "groupName": "python base image",
            "matchDatasources": [
                "docker"
            ],
            "matchDepNames": [
                "python"
            ]
        },
        {
            "description": "Python major and minor upgrades are done by hand, because the version comes from the python_version_max cookiecutter variable recorded in .cruft.json, and is rendered from there into .python-version, pyproject.toml, the CI matrices and the Dockerfile, so it cannot be bumped by editing a single file",
            "enabled": false,
            "matchDatasources": [
                "docker"
            ],
            "matchDepNames": [
                "python"
            ],
            "matchUpdateTypes": [
                "major",
                "minor"
            ]
        },
        {
            "description": "Immediately apply updates of mex packages, in dedicated PR",
            "groupName": null,
            "matchPackageNames": [
                "mex-*"
            ],
            "minimumReleaseAge": "0 days"
        }
    ],
    "prFooter": "",
    "pre-commit": {
        "enabled": true
    },
    "schedule": [
        "on monday and wednesday"
    ],
    "timezone": "Europe/Berlin",
    "vulnerabilityAlerts": {
        "enabled": true
    }
}
